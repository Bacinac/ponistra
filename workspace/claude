#!/bin/sh
# The agent the editor's extension brings, its newest version, as the chats run the same.
for found in $(find "$HOME/.local/share/code-server/extensions" -maxdepth 1 -name 'anthropic.claude-code-*' 2>/dev/null | sort -rV); do
	[ -x "$found/resources/native-binary/claude" ] && exec "$found/resources/native-binary/claude" "$@"
done
echo "claude: Claude Code is not installed in the workspace; the editor's Extensions view installs it" >&2
exit 127
