# Copy to .env on the dev host. An installation's own .env is written by ponistra install.

# The release compose.yaml runs. On the dev host compose.override.yaml builds and names the
# images itself, but compose.yaml still asks for these two.
PONISTRA_VERSION=dev
# A domain, whose certificate Caddy fetches on port 443 (80 only sends to https), or ":80"
# behind a proxy or tunnel that ends TLS. The host ports for Caddy's 80 and 443:
#   PONISTRA_HTTP_PORT=80
#   PONISTRA_HTTPS_PORT=443
PONISTRA_SITE=:80

# Signs sessions. Required.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
PONISTRA_SECRET_KEY=

# Set in Postgres at first start and in the backend's connection. Hex only. An
# existing database keeps the password it was created with: change it there
# first (ALTER ROLE ponistra PASSWORD '…').
#   python3 -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=

# Encrypts the snapshots in volumes/backup (ponistra backup, and one before every update).
# Keep a copy away from this disk: without it the snapshots cannot be opened.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
RESTIC_PASSWORD=

# Signs the keys browsers join meetings with (LiveKit).
#   python3 -c "import secrets; print(secrets.token_hex(32))"
PONISTRA_LIVEKIT_SECRET=

# The ports meetings' sound and video reach this host on, which a meeting from outside the
# local network needs forwarded to it.
#   PONISTRA_LIVEKIT_UDP_PORT=7882
#   PONISTRA_LIVEKIT_TCP_PORT=7881

# Meetings' relay, for networks that let out neither of those ports, often only HTTPS: a name
# pointing straight at this host's public address (not through a proxy or tunnel), with TCP 443
# and UDP 3478 forwarded here. Caddy fetches its certificate on 443.
#   PONISTRA_TURN=turn.example.com

# Where Cloudflare keeps the names pointing straight at this host (the relay's, and the domain
# where TLS ends here), a token for its zone (Zone: Read, DNS: Edit) keeps them on the host's
# public address as it changes.
#   PONISTRA_CLOUDFLARE_TOKEN=

# An installation only: the host names the app is opened on, comma-separated.
#   PONISTRA_ALLOWED_HOSTS=ponistra.example.com
PONISTRA_ALLOWED_HOSTS=

# Where the app is reached from outside, which an outside agent (D18) and the code workspace's
# agent (D34) are told to sign in at. ponistra install writes an installation's; dev's is its Vite.
#   PONISTRA_PUBLIC_URL=https://ponistra.example.com

# An installation only: the code its first administrator enters in the browser. Without
# one, the first account is made with manage.py createsuperuser.
#   PONISTRA_SETUP_CODE=K7QM-4XTR-9PWD-HB2C

# How many long jobs (saving as a file, importing, copying, composing pages) the
# backend does at once; the rest wait their turn. Printing a large document as
# PDF takes the printer about 1.6 GB, so a host with 4 GB of memory does one.
#   PONISTRA_JOBS_AT_ONCE=1

# The largest file the app takes, in GB. A file arrives in pieces, so a proxy's or a tunnel's
# limit on one request does not bound it.
#   PONISTRA_FILE_MAX_GB=10

# The code page the tables' CHAR and CODE count characters by, as Excel takes it from the
# Windows its users have: cp1250 for Central Europe, cp1252 for Western Europe and America.
#   PONISTRA_CODE_PAGE=cp1250

# The owner's code workspace (D34), VS Code in the browser for that one user and no one else:
# their e-mail, the workspace's service and its home at the same path as on the host. ponistra
# install and ponistra workspace write these.
#   COMPOSE_PROFILES=workspace
#   PONISTRA_WORKSPACE=ana@example.com
#   PONISTRA_WORKSPACE_HOME=/srv/ponistra/volumes/workspace
# Its agent runs Docker on the host, which is root on it, only where the owner chose that.
#   COMPOSE_FILE=compose.yaml:compose.docker.yaml
#   PONISTRA_DOCKER_GID=988
# Or a workspace the owner runs elsewhere, behind a door of its own: their e-mail and its https://
# address, which Code in the rail opens. The installation then runs, keeps and guards none.
#   PONISTRA_WORKSPACE=ana@example.com
#   PONISTRA_WORKSPACE_URL=https://code.example.com
